{# Maule Irrigation Agreement — MACHICURA (embalse) variant           #}
{#                                                                   #}
{# Identical to maule.tson except that the riego rights                #}
{# (normal / ordinario) are physically withdrawn at the               #}
{# daily-cycle MACHICURA reservoir (`junction_a = junction_retiro`).  #}
