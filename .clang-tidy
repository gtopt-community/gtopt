---
# Only apply to C++ files (exclude Python and CMake files)
#
# Disabled-check rationale (groups):
#   altera-*, llvmlibc-*        – domain-specific (FPGA / LLVM libc); not relevant
#   abseil-*,                   – the project uses neither Abseil nor
#   google-upgrade-googletest-case  googletest; these checks only rewrite
#                                 towards absl:: / gtest APIs, yet their
#                                 matchers cost ~5% of clang-tidy time
#                                 (--enable-check-profile, 11 TUs)
#   fuchsia-*                   – Fuchsia OS style; conflicts with project conventions
#   llvm-*                      – LLVM-project conventions: header guards (we
#                                 use #pragma once), include order (clang-format
#                                 does it), namespace comments, isa/dyn_cast,
#                                 Twine, MLIR op builders, llvm:: range helpers
#                                 (llvm-use-ranges), register types.  None
#                                 applies to gtopt.
#   android-*, darwin-*, objc-*, – foreign platforms / ecosystems (Android
#   zircon-*, linuxkernel-*,       bionic cloexec, Apple / Objective-C, Zircon,
#   mpi-*, openmp-*, boost-*,      Linux kernel, MPI, OpenMP pragmas, Boost
#   google-objc-*                  idioms): gtopt has no such code (boost is
#                                 only boost::container; boost-use-to-string /
#                                 boost-use-ranges produce no findings).  The
#                                 matchers still cost time on every TU.
#   portability-avoid-pragma-once – project uses #pragma once
#   google-readability-namespace-comments – project already writes
#                                 }  // namespace gtopt comments
#   google-runtime-int          – project style uses int / long / std::int64_t
#                                 freely (Arrow / COIN-OR / solver APIs); the
#                                 int16/int64 rewrite is not wanted.
#   google-runtime-float        – (clang-tidy ≥ 22) "long double" ban; none in
#                                 the codebase and not a project rule.
#   google-readability-avoid-underscore-in-googletest-name – googletest only
#   google-build-using-namespace – 'using namespace' in .cpp TU scope is accepted
#   google-readability-casting  – project uses C++ casts; extra verbosity not required
#   modernize-use-trailing-return-type – project uses both styles; not enforced
#   modernize-macro-to-enum,    – COIN-OR and other deps rely on C macros
#   cppcoreguidelines-macro-*
#   misc-multiple-inheritance,  – deliberately used in the codebase
#   misc-non-private-member-variables-in-classes – structs with public members are idiomatic
#   misc-include-cleaner        – too aggressive; third-party transitive includes common
#   misc-confusable-identifiers – false-positive-prone; math code uses i/j/l variables
#   readability-magic-numbers,  – LP coefficients (0.0, 1.0, 0.5) are self-documenting
#   cppcoreguidelines-avoid-magic-numbers
#   readability-identifier-length  – single-char vars are idiomatic in LP/math code
#   readability-identifier-naming  – project has its own naming conventions
#   readability-function-cognitive-complexity – subjective; not enforced
#   readability-redundant-member-init – project uses explicit {} init for clarity
#   readability-trailing-comma  – (clang-tidy ≥ 23) suggests REMOVING trailing
#                                 commas; the project style (CONTRIBUTING.md)
#                                 mandates them on every
#                                 brace-initializer list
#   bugprone-easily-swappable-parameters – too noisy in LP/math API functions
#   bugprone-lambda-function-name – __func__ in lambdas; harmless pattern
#   cppcoreguidelines-pro-bounds-avoid-unchecked-container-access – []  preferred
#                                  over .at() in hot LP-assembly paths
#   cppcoreguidelines-pro-bounds-constant-array-index – sibling of the
#                                  check above: runtime-indexed [] on
#                                  std::array with loop-bounded indices is
#                                  the hot path in label caches, SHA-256
#                                  fingerprinting, and consteval table
#                                  builders (where OOB already fails the
#                                  compile).  gsl::at() is not a project
#                                  dependency.
#   clang-analyzer-{cplusplus.NewDeleteLeaks, – false positives with COIN-OR
#     security.ArrayBound,
#     core.uninitialized.UndefReturn,
#     unix.Stream}
#   clang-analyzer-core.uninitialized.Assign   – false positive tracing the
#                                  std::expected error-path move of the Error
#                                  struct through libstdc++ 15 internals (e.g.
#                                  planning_lp.cpp .transform_error()).
#   clang-analyzer-optin.core.EnumCastOutOfRange – false positive on bitmask /
#                                  flag enums (OutputFlags): combined values
#                                  such as 1|2=3 and 1|2|4=7 are valid bit
#                                  unions, not named enumerators.
#   clang-diagnostic-{c2y-extensions,          – compiler-version noise; not actionable
#     constexpr-local-var-non-literal-type,
#     template-param-default-arg-redefinition}
#   illegal-initializer-type    – Clang-specific; no violations in codebase
#   misc-no-recursion           – recursion is idiomatic (parsers, LP-element
#                                  traversal, ensure_backend chains).  The
#                                  check is widely considered over-pedantic.
#   cppcoreguidelines-pro-bounds-pointer-arithmetic – intrinsic to
#                                  std::to_chars/from_chars, dlopen plugin
#                                  scanning, codec buffer walking, and
#                                  constraint-parser tokeniser; incompatible
#                                  with low-level / systems C++.
#   bugprone-empty-catch        – ``catch (...) {}`` is the documented
#                                  best-effort pattern in monitor / atexit
#                                  / logger sites.  See the explanatory
#                                  comment that sits next to every such
#                                  block in the codebase.
#   hicpp-signed-bitwise        – POSIX ``WIFEXITED/WIFSIGNALED/
#                                  WEXITSTATUS`` macros expand to signed
#                                  bitwise ops; no portable alternative.
#   concurrency-mt-unsafe       – all current uses are ``getenv``
#                                  (startup), ``dlerror`` (post-dlopen),
#                                  ``::_exit`` (single-threaded child of
#                                  the plugin-validation fork), and
#                                  ``popen`` (SDDP-infeasibility probe).
#                                  None of those have a thread-safe
#                                  replacement in standard C++ / POSIX.
#                                  ``FunctionSet=posix`` does *not* drop
#                                  them — they are on the POSIX
#                                  mt-unsafe list — so disabling the
#                                  check project-wide is the only clean
#                                  alternative to 21 per-site NOLINTs.
#
# Alias de-duplication (speed only, no coverage change):
#   clang-tidy registers every alias name as a separate check instance,
#   so with "*" each alias re-runs the AST matchers of its primary check
#   and emits a duplicate diagnostic at the same location.  Every alias
#   of the clang-tidy-22 alias table (docs: checks/list "Check aliases")
#   whose primary is enabled is disabled at the end of the list below;
#   the canonical bugprone / misc / modernize / readability name stays.
#   Aliases with option defaults different from the primary's were
#   checked one by one (clang-tidy-22 --dump-config):
#     cert-arr39-c, cert-dcl16-c, cert-str34-c,
#     google-readability-braces-around-statements, llvm-else-after-return,
#     llvm-qualified-auto – the alias defaults are a strict subset of the
#                           primary's (it flags fewer sites): dropped.
#     cert-oop54-cpp      – flags MORE sites than the primary
#                           (WarnOnlyIfThisHasSuspiciousField=false);
#                           that option is moved to
#                           bugprone-unhandled-self-assignment below.
#     cppcoreguidelines-narrowing-conversions – PedanticMode=true moved
#                           to bugprone-narrowing-conversions below.
#     cppcoreguidelines-non-private-member-variables-in-classes – kept:
#                           its primary (misc-) is disabled above and the
#                           alias (IgnoreClassesWithAllMemberVariables-
#                           BeingPublic=true) only flags mixed classes.
#   cert-dcl50/dcl58/env33/err34/err52/err58/err60/flp30/mem57/msc50/
#   msc51/oop57/oop58 became aliases of bugprone-/misc-/modernize- checks
#   in clang-tidy 22; NOLINTs now use the canonical name.
#
# clang-analyzer subfamilies for foreign platforms / APIs: osx.*,
#   optin.osx.*, webkit.*, fuchsia.*, optin.mpi.*,
#   apiModeling.google.GTest, optin.performance.GCDAntipattern,
#   security.insecureAPI.decodeValueOfObjCType, core.NonnilStringConstants
#   (ObjC), nullability.* (_Nonnull annotations, not used by gtopt).
#   The rest of the analyzer is kept, but runs only in the nightly full
#   CI run (tools/run_tidy.sh --no-analyzer on PR / push; see
#   .github/workflows/clang-tidy.yml).
Checks: "*,\
  -abseil-*,\
  -altera-*,\
  -android-*,\
  -boost-*,\
  -bugprone-easily-swappable-parameters,\
  -bugprone-empty-catch,\
  -bugprone-lambda-function-name,\
  -clang-analyzer-core.uninitialized.Assign,\
  -clang-analyzer-core.uninitialized.UndefReturn,\
  -clang-analyzer-cplusplus.NewDeleteLeaks,\
  -clang-analyzer-optin.core.EnumCastOutOfRange,\
  -clang-analyzer-security.ArrayBound,\
  -clang-analyzer-unix.Stream,\
  -clang-analyzer-apiModeling.google.GTest,\
  -clang-analyzer-core.NonnilStringConstants,\
  -clang-analyzer-fuchsia.*,\
  -clang-analyzer-nullability.*,\
  -clang-analyzer-optin.mpi.*,\
  -clang-analyzer-optin.osx.*,\
  -clang-analyzer-optin.performance.GCDAntipattern,\
  -clang-analyzer-osx.*,\
  -clang-analyzer-security.insecureAPI.decodeValueOfObjCType,\
  -clang-analyzer-webkit.*,\
  -clang-diagnostic-c2y-extensions,\
  -clang-diagnostic-constexpr-local-var-non-literal-type,\
  -clang-diagnostic-template-param-default-arg-redefinition,\
  -concurrency-mt-unsafe,\
  -cppcoreguidelines-avoid-magic-numbers,\
  -darwin-*,\
  -fuchsia-*,\
  -cppcoreguidelines-macro-to-enum,\
  -cppcoreguidelines-macro-usage,\
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,\
  -cppcoreguidelines-pro-bounds-constant-array-index,\
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,\
  -google-objc-*,\
  -google-readability-avoid-underscore-in-googletest-name,\
  -google-runtime-float,\
  -google-runtime-int,\
  -google-upgrade-googletest-case,\
  -google-build-using-namespace,\
  -google-readability-casting,\
  -google-readability-namespace-comments,\
  -hicpp-signed-bitwise,\
  -illegal-initializer-type,\
  -linuxkernel-*,\
  -llvm-*,\
  -llvmlibc-*,\
  -misc-confusable-identifiers,\
  -misc-include-cleaner,\
  -misc-multiple-inheritance,\
  -misc-no-recursion,\
  -misc-non-private-member-variables-in-classes,\
  -modernize-macro-to-enum,\
  -modernize-use-trailing-return-type,\
  -mpi-*,\
  -objc-*,\
  -openmp-*,\
  -portability-avoid-pragma-once,\
  -readability-function-cognitive-complexity,\
  -readability-identifier-length,\
  -readability-identifier-naming,\
  -readability-magic-numbers,\
  -readability-redundant-member-init,\
  -readability-trailing-comma,\
  -zircon-*,\
  -cert-arr39-c,\
  -cert-con36-c,\
  -cert-con54-cpp,\
  -cert-ctr56-cpp,\
  -cert-dcl03-c,\
  -cert-dcl16-c,\
  -cert-dcl37-c,\
  -cert-dcl50-cpp,\
  -cert-dcl51-cpp,\
  -cert-dcl54-cpp,\
  -cert-dcl58-cpp,\
  -cert-dcl59-cpp,\
  -cert-env33-c,\
  -cert-err09-cpp,\
  -cert-err34-c,\
  -cert-err52-cpp,\
  -cert-err58-cpp,\
  -cert-err60-cpp,\
  -cert-err61-cpp,\
  -cert-exp42-c,\
  -cert-fio38-c,\
  -cert-flp30-c,\
  -cert-flp37-c,\
  -cert-int09-c,\
  -cert-mem57-cpp,\
  -cert-msc24-c,\
  -cert-msc30-c,\
  -cert-msc32-c,\
  -cert-msc33-c,\
  -cert-msc50-cpp,\
  -cert-msc51-cpp,\
  -cert-msc54-cpp,\
  -cert-oop11-cpp,\
  -cert-oop54-cpp,\
  -cert-oop57-cpp,\
  -cert-oop58-cpp,\
  -cert-pos44-c,\
  -cert-pos47-c,\
  -cert-sig30-c,\
  -cert-str34-c,\
  -cppcoreguidelines-avoid-c-arrays,\
  -cppcoreguidelines-c-copy-assignment-signature,\
  -cppcoreguidelines-explicit-virtual-functions,\
  -cppcoreguidelines-narrowing-conversions,\
  -cppcoreguidelines-noexcept-destructor,\
  -cppcoreguidelines-noexcept-move-operations,\
  -cppcoreguidelines-noexcept-swap,\
  -cppcoreguidelines-use-default-member-init,\
  -google-build-namespaces,\
  -google-readability-braces-around-statements,\
  -google-readability-function-size,\
  -hicpp-avoid-c-arrays,\
  -hicpp-avoid-goto,\
  -hicpp-braces-around-statements,\
  -hicpp-deprecated-headers,\
  -hicpp-explicit-conversions,\
  -hicpp-function-size,\
  -hicpp-invalid-access-moved,\
  -hicpp-member-init,\
  -hicpp-move-const-arg,\
  -hicpp-named-parameter,\
  -hicpp-new-delete-operators,\
  -hicpp-no-array-decay,\
  -hicpp-no-malloc,\
  -hicpp-noexcept-move,\
  -hicpp-special-member-functions,\
  -hicpp-static-assert,\
  -hicpp-undelegated-constructor,\
  -hicpp-uppercase-literal-suffix,\
  -hicpp-use-auto,\
  -hicpp-use-emplace,\
  -hicpp-use-equals-default,\
  -hicpp-use-equals-delete,\
  -hicpp-use-noexcept,\
  -hicpp-use-nullptr,\
  -hicpp-use-override,\
  -hicpp-vararg\
  "

HeaderFilterRegex: '.*'
SystemHeaders: false

WarningsAsErrors: ''
CheckOptions:
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: true
  - key: bugprone-use-after-move.IgnoreUnnamedTypes
    value: false
  - key: bugprone-use-after-move.IgnorePartialMoves
    value: false
  - key: 'bugprone-argument-comment.StrictMode'
    value: 'true'
# Prefer using enum classes with 2 values for parameters instead of bools
  - key: 'bugprone-argument-comment.CommentBoolLiterals'
    value: 'true'
  - key: 'bugprone-misplaced-widening-cast.CheckImplicitCasts'
    value: 'true'
  - key: 'bugprone-sizeof-expression.WarnOnSizeOfIntegerExpression'
    value: 'true'
  - key: 'bugprone-suspicious-string-compare.WarnOnLogicalNotComparison'
    value: 'true'
  - key: 'readability-simplify-boolean-expr.ChainedConditionalReturn'
    value: 'true'
  - key: 'readability-simplify-boolean-expr.ChainedConditionalAssignment'
    value: 'true'
  - key: 'readability-uniqueptr-delete-release.PreferResetCall'
    value: 'true'
  - key: 'cppcoreguidelines-init-variables.MathHeader'
    value: '<cmath>'
  - key: 'bugprone-narrowing-conversions.PedanticMode'
    value: 'true'
# Was the default of the (disabled) alias cert-oop54-cpp: flag every
# copy assignment without a self-assignment guard, not only classes
# holding pointer members.
  - key: 'bugprone-unhandled-self-assignment.WarnOnlyIfThisHasSuspiciousField'
    value: 'false'
  - key: 'readability-else-after-return.WarnOnUnfixable'
    value: 'true'
  - key: 'readability-else-after-return.WarnOnConditionVariables'
    value: 'true'
  - key: 'readability-inconsistent-declaration-parameter-name.Strict'
    value: 'true'
  - key: 'readability-qualified-auto.AddConstToQualified'
    value: 'true'
  - key: 'readability-redundant-access-specifiers.CheckFirstDeclaration'
    value: 'true'
...
