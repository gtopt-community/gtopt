[Unit]
Description=GTOpt Web Service
Documentation=https://github.com/gtopt-community/gtopt
After=network.target

[Service]
Type=simple
User=gtopt
Group=gtopt
WorkingDirectory=/usr/local/share/gtopt/webservice

# Environment variables
Environment="PORT=3000"
# Bind to loopback only (default).  To expose the service on another
# interface, set GTOPT_WEBSERVICE_HOST and an API token (the launcher
# refuses a non-loopback bind without one), and put a TLS reverse proxy
# in front of it.  Keep the token out of this file, e.g.:
#   EnvironmentFile=/etc/gtopt/webservice.env   (mode 0600, contains
#   GTOPT_WEBSERVICE_API_TOKEN=<long random secret>)
Environment="GTOPT_WEBSERVICE_HOST=127.0.0.1"
Environment="GTOPT_BIN=/usr/local/bin/gtopt"
Environment="GTOPT_DATA_DIR=/var/lib/gtopt/data"
Environment="GTOPT_LOG_DIR=/var/log/gtopt"
Environment="NODE_ENV=production"

# Start the service using the installed launcher
ExecStart=/usr/local/bin/gtopt_websrv

# Restart policy
Restart=on-failure
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gtopt-webservice

[Install]
WantedBy=multi-user.target
