{
  "name": "gtopt-webservice",
  "version": "1.1.0",
  "description": "Web service for running GTOpt (Generation, Transmission and storage Optimization) cases",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "bash test/integration_test.sh",
    "test:unit": "jest --coverage",
    "test:e2e": "bash test/e2e_test.sh",
    "test:e2e-real": "bash test/e2e_real_test.sh",
    "test:install": "bash test/install_test.sh"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "next": "^16.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^14.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "test-exclude": {
      ".": "^8.0.0",
      "minimatch": "^11.0.9"
    },
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
