---
# Test-tree overrides — inherits the project root .clang-tidy and disables
# checks that are pure noise for doctest test files.
#
# Unity-build artifact checks: gtoptTests compiles with CMake UNITY_BUILD
# (test/CMakeLists.txt), so every test_*.cpp is #included into a
# unity_N_cxx.cxx TU and clang-tidy classifies its contents as "header"
# code.  That falsely triggers the in-header hygiene checks on two
# sanctioned test idioms (see CLAUDE.md "Writing New Tests"):
#
#   using namespace gtopt;      – file-scope using in every test file
#     google-global-names-in-headers
#   namespace { ... helpers }   – anonymous-namespace test helpers
#     cert-dcl59-cpp, google-build-namespaces,
#     misc-anonymous-namespace-in-header
#
# Test-fixture noise:
#   misc-const-correctness      – test bodies build fixtures incrementally
#                                 and mutate them across SUBCASEs; the
#                                 const-annotation churn adds nothing to
#                                 test readability.
#
# doctest idiom noise:
#   bugprone-unchecked-optional-access – the flow-sensitive analysis does
#                                 not model REQUIRE(opt.has_value()) as a
#                                 terminating guard (doctest's REQUIRE
#                                 throws from an out-of-line react()), so
#                                 every `*opt` / `opt->x` after a REQUIRE
#                                 is reported; >98% of the hits in
#                                 test/source were REQUIRE-guarded.  A
#                                 REQUIRE failure aborts the test case, so
#                                 the access is unreachable when empty.
#                                 Production code keeps the check at full
#                                 strength.
#   cert-err58-cpp              – file-scope fixture objects (Simulation,
#                                 bus/demand arrays) shared across the
#                                 TEST_CASEs of a file; a throw during
#                                 static init simply aborts the test
#                                 binary, which is the desired outcome.
#   misc-use-internal-linkage   – test helpers live in per-file *named*
#                                 namespaces (test_<topic>::) because the
#                                 unity build merges anonymous namespaces
#                                 of ~11 files into one TU, where helpers
#                                 such as make_chrono_4h_simulation()
#                                 would collide.  `static` would in turn
#                                 trip misc-use-anonymous-namespace.
#
# Everything else (bugprone-*, performance-*, modernize-*, …) still
# applies to tests at full strength.
InheritParentConfig: true
Checks: "\
  -bugprone-unchecked-optional-access,\
  -cert-dcl59-cpp,\
  -cert-err58-cpp,\
  -google-build-namespaces,\
  -google-global-names-in-headers,\
  -misc-anonymous-namespace-in-header,\
  -misc-const-correctness,\
  -misc-use-internal-linkage\
  "
