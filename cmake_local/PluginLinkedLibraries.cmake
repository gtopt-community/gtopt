# Script mode (cmake -P): write the C++ rows of
# `gtopt_plugin_linked_libraries.inc` -- the identity of every SHARED
# library a solver plugin links -- for plugins/common/
# plugin_linked_libraries.cpp.  Run as a build step before the plugin is
# compiled (cmake_local/GtoptPlugin.cmake); SolverRegistry compares the
# solver library mapped at run time with these rows and refuses a foreign
# one (a fake libhighs.so.1 in LD_LIBRARY_PATH, an LD_PRELOAD, a replaced
# file) even when it reports the expected version.
#
#   cmake -DREADELF=<readelf or ""> -DLIBS=<a|b|c> -DOUT=<file.inc>
#         [-DFULL_HASH=ON] -P PluginLinkedLibraries.cmake
#
# FULL_HASH=ON (CMake option GTOPT_SOLVER_LIB_FULL_HASH) records the SHA-256
# of every library, not only of those without a build-id; gtopt then also
# hashes the mapped file at load and refuses a different content.
#
# One row per shared object (static archives and linker flags are skipped):
#   {"<soname>", "<build-id>", "<sha256 if no build-id / FULL_HASH>",
#    "<real path>"},
# The file is only rewritten when its content changes.
if(NOT OUT)
  message(FATAL_ERROR "PluginLinkedLibraries: OUT is required")
endif()

string(REPLACE "|" ";" _libs "${LIBS}")
set(_rows "")
set(_seen "")
foreach(_lib IN LISTS _libs)
  if(_lib STREQUAL "" OR NOT IS_ABSOLUTE "${_lib}" OR NOT EXISTS "${_lib}")
    continue()
  endif()
  file(REAL_PATH "${_lib}" _real)
  get_filename_component(_name "${_real}" NAME)
  if(NOT _name MATCHES "\\.so(\\.[0-9]+)*$")
    continue()  # static archive, object file, ...
  endif()
  file(READ "${_real}" _magic LIMIT 4 HEX)
  if(NOT _magic STREQUAL "7f454c46")
    continue()  # linker script (e.g. libm.so), not an ELF object
  endif()
  if(_real IN_LIST _seen)
    continue()
  endif()
  list(APPEND _seen "${_real}")

  set(_soname "")
  set(_build_id "")
  if(READELF)
    execute_process(COMMAND "${READELF}" -d "${_real}"
                    OUTPUT_VARIABLE _dyn ERROR_QUIET)
    if(_dyn MATCHES "Library soname: \\[([^]]+)\\]")
      set(_soname "${CMAKE_MATCH_1}")
    endif()
    execute_process(COMMAND "${READELF}" -n "${_real}"
                    OUTPUT_VARIABLE _notes ERROR_QUIET)
    if(_notes MATCHES "Build ID:[ \t]*([0-9a-fA-F]+)")
      string(TOLOWER "${CMAKE_MATCH_1}" _build_id)
    endif()
  endif()
  if(_soname STREQUAL "")
    set(_soname "${_name}")
  endif()
  set(_sha256 "")
  if(_build_id STREQUAL "" OR FULL_HASH)
    file(SHA256 "${_real}" _sha256)
  endif()
  foreach(_v _soname _real)
    string(REPLACE "\\" "\\\\" ${_v} "${${_v}}")
    string(REPLACE "\"" "\\\"" ${_v} "${${_v}}")
  endforeach()
  string(APPEND _rows
    "    {\"${_soname}\", \"${_build_id}\", \"${_sha256}\", \"${_real}\"},\n")
endforeach()

set(_content "// Generated by cmake_local/PluginLinkedLibraries.cmake -- do not edit.\n${_rows}")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
  if(_old STREQUAL _content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${_content}")
