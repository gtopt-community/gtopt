%% GTOpt architecture overview.
%% Render: npx -y @mermaid-js/mermaid-cli@11 -i tools/figures/architecture.mmd \
%%           -o docs/images/architecture.svg -b white -c tools/figures/mermaid.json
flowchart TB
  subgraph IN["Inputs"]
    direction LR
    json["JSON case<br/>+ Parquet / CSV<br/>time series"]
    conv["Converters<br/>PLP · PLEXOS · PSS/E<br/>SDDP · pandapower"]
    xls["Excel workbook<br/>(igtopt)"]
  end

  subgraph CORE["gtopt core (C++26)"]
    direction LR
    sys["System model<br/>buses · lines · units<br/>storage · hydro"]
    lp["LP / MIP assembly<br/>scenarios · stages · blocks"]
    meth["Methods<br/>monolithic · SDDP · cascade"]
    sys --> lp --> meth
  end

  subgraph SDK["Solver plugins (Extension SDK)"]
    direction LR
    open["Open source<br/>HiGHS · CBC / CLP<br/>SCIP · cuOpt"]
    comm["Commercial<br/>CPLEX · Gurobi<br/>MindOpt"]
  end

  subgraph OUT["Results"]
    direction LR
    pq["Parquet / CSV<br/>dispatch · prices · duals<br/>investment · water values"]
  end

  subgraph UI["Tools and interfaces"]
    direction LR
    tui["run_gtopt<br/>terminal dashboard"]
    gui["Browser GUI<br/>(gtopt_gui)"]
    web["REST web service<br/>(gtopt_websrv)"]
    cmp["gtopt_compare<br/>gtopt_diagram"]
  end

  conv --> json
  xls --> json
  json --> sys
  meth <--> open
  meth <--> comm
  meth --> pq
  pq --> tui
  pq --> gui
  pq --> web
  pq --> cmp

  classDef core fill:#e8f1fc,stroke:#2a78d6,color:#0b0b0b;
  classDef io fill:#fdf0ea,stroke:#eb6834,color:#0b0b0b;
  classDef sdk fill:#e6f6ef,stroke:#1baf7a,color:#0b0b0b;
  classDef ui fill:#efedfb,stroke:#6250d6,color:#0b0b0b;
  class sys,lp,meth core;
  class json,conv,xls,pq io;
  class open,comm sdk;
  class tui,gui,web,cmp ui;
